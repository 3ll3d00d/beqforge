diff --git a/tests/test_design_ripple_band.py b/tests/test_design_ripple_band.py
new file mode 100644
index 0000000..c0559b9
--- /dev/null
+++ b/tests/test_design_ripple_band.py
@@ -0,0 +1,68 @@
+"""The mix's texture yardstick is measured in the band the sub plays (9, 2009, 2026-10)."""
+
+import numpy as np
+from scipy import signal
+
+from beqforge.material import Material
+from beqforge.pipeline import PipelineParams, passband_ripple_db
+
+FS = 1000
+
+
+def _lfe_led(
+    high_pass_hz: float = 20.0, knee_hz: float = 70.0, seed: int = 5
+) -> Material:
+    """Noise high-passed at `high_pass_hz` whose level falls away above `knee_hz`.
+
+    The knee stands in for an LFE-led mix, where the level drops where the LFE channel's content
+    ends: real programme shape, but not texture the sub plays.
+    """
+    rng = np.random.default_rng(seed)
+    noise = rng.standard_normal(240 * FS)
+    bass = signal.sosfilt(
+        signal.butter(4, knee_hz, btype="low", fs=FS, output="sos"),
+        signal.sosfilt(
+            signal.butter(4, high_pass_hz, btype="high", fs=FS, output="sos"), noise
+        ),
+    )
+    mains = 0.05 * signal.sosfilt(
+        signal.butter(4, high_pass_hz, btype="high", fs=FS, output="sos"),
+        rng.standard_normal(noise.size),
+    )
+    return Material("lfe-led", FS, 0.01 * (bass + mains), {}, "complete_programme")
+
+
+def test_the_ripple_is_measured_up_to_the_sub_edge():
+    params = PipelineParams()
+    ripple = passband_ripple_db(_lfe_led(), params, in_sub_band=True)
+    assert ripple is not None
+    assert ripple[1][1] == params.playback.crossover_hz
+
+
+def test_a_knee_above_the_sub_edge_is_not_read_as_texture():
+    material = _lfe_led()
+    params = PipelineParams()
+    in_sub_band = passband_ripple_db(material, params, in_sub_band=True)
+    # what the yardstick is over the whole passband, as each channel's own rule measures it
+    to_band_top = passband_ripple_db(material, params)
+    assert in_sub_band is not None and to_band_top is not None
+    assert to_band_top[1][1] == params.diagnose.band_hz[1]
+    assert in_sub_band[0] < to_band_top[0] - 3.0
+
+
+def test_a_judged_band_past_the_sub_edge_keeps_the_analysis_band():
+    # a passband that only starts above the crossover: there is nothing below the sub edge to
+    # measure, so the yardstick is the one it always was
+    params = PipelineParams()
+    ripple = passband_ripple_db(
+        _lfe_led(high_pass_hz=110.0, knee_hz=400.0), params, in_sub_band=True
+    )
+    assert ripple is None or ripple[1][1] == params.diagnose.band_hz[1]
+
+
+def test_a_channel_s_own_rule_keeps_the_whole_passband():
+    # the per-channel texture rule: a smaller yardstick there judged more channels short and
+    # admitted a broadband negative on the corpus
+    params = PipelineParams()
+    ripple = passband_ripple_db(_lfe_led(), params)
+    assert ripple is not None and ripple[1][1] == params.diagnose.band_hz[1]
